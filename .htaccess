# BEGIN SKALUM HARDENING
# Managed by hand. Kept ABOVE the LSCACHE/WordPress markers on purpose:
# those blocks are regenerated by their plugins, this one must survive.
# mod_rewrite evaluates in file order, so these rules run before WP's
# front controller and before any real file in uploads/ gets served.

# --- Deny by filename: secrets, backups, logs, dev leftovers ---------------
<FilesMatch "(?i)^(wp-config\.php|wp-config-sample\.php|readme\.html|license\.txt|\.user\.ini|\.htaccess|\.htpasswd|local-phpinfo\.php|local-xdebuginfo\.php|adminer.*\.php|composer\.(json|lock)|package(-lock)?\.json|gulpfile\.mjs|postcss\.config\.js|\.env.*|.*\.(log|logs|bk|bak|old|save|orig|rej|swp|sql|sql\.gz|dump|tar|tar\.gz|gz|zip|rar|7z|ini|sh|pem|key|p12|ppk|md|yml|yaml))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- No PHP execution inside uploads (main shell-upload vector) ----------
  RewriteRule ^wp-content/uploads/.*\.(?i:php|phtml|phps|php[0-9]|phar|pl|py|cgi|asp|aspx|jsp|sh)$ - [F,L]

  # --- No PHP execution in other writable/asset dirs -----------------------
  RewriteRule ^wp-content/(cache|upgrade|backups|ai1wm-backups|litespeed)/.*\.(?i:php|phtml|php[0-9]|phar)$ - [F,L]
  RewriteRule ^wp-content/themes/[^/]+/(assets|acf-json|node_modules|scripts)/.*\.(?i:php|phtml|php[0-9]|phar)$ - [F,L]

  # --- Never serve VCS / build internals ----------------------------------
  RewriteRule (^|/)\.(git|svn|hg|idea|vscode)(/|$) - [F,L]
  RewriteRule ^wp-content/themes/[^/]+/acf-json/ - [F,L]

  # Composer/npm internals only. Deliberately NOT a blanket /vendor/ block:
  # the theme legitimately serves assets/js/vendor/particles.min.js.
  RewriteRule (^|/)vendor/(composer/|autoload\.php) - [F,L]
  RewriteRule (^|/)node_modules/.*\.(?i:php|phtml|json|md|yml|yaml|lock|ts|map)$ - [F,L]

  # --- Any log file, anywhere ---------------------------------------------
  RewriteRule (?i)\.log$ - [F,L]
  RewriteRule (?i)(^|/)(error_log|php_errorlog|debug\.log)$ - [F,L]

  # --- xmlrpc.php: already disabled in PHP, block at server level too -----
  RewriteRule ^xmlrpc\.php$ - [F,L]

  # --- Migration tooling: reachable installers are a known RCE/LFI path ----
  # Duplicator ships dup-installer/ inside the plugin and it answers over HTTP.
  # Nothing fetches it via the browser during normal admin use; it is only
  # used when unpacking a package on a fresh server.
  RewriteRule ^installer(-backup)?\.php$ - [F,L]
  RewriteRule ^installer-(log\.txt|data\.sql)$ - [F,L]
  RewriteRule (^|/)dup-installer/ - [F,L]
  RewriteRule ^wp-content/backups-dup-(pro|lite)/ - [F,L]
  RewriteRule ^wp-content/ai1wm-backups/ - [F,L]
  RewriteRule (?i)\.(wpress|daf)$ - [F,L]

  # --- Block author enumeration before PHP even boots ---------------------
  RewriteCond %{QUERY_STRING} (^|&)author=\d [NC]
  RewriteRule ^/?$ - [F,L]

  # --- Common injection probes in the query string ------------------------
  # Conservative on purpose: only patterns with no legitimate use on this site.
  RewriteCond %{QUERY_STRING} (\<|%3C)script(\>|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} (base64_encode|base64_decode)\s*\( [NC,OR]
  RewriteCond %{QUERY_STRING} (GLOBALS|_REQUEST)(=|\[|%5B|%3D) [NC,OR]
  RewriteCond %{QUERY_STRING} (union[\s+]+select|concat\s*\(|information_schema) [NC,OR]
  RewriteCond %{QUERY_STRING} (\.\./|\.\.%2f){2,} [NC,OR]
  RewriteCond %{QUERY_STRING} (php|data|file|expect)://  [NC]
  RewriteRule .* - [F,L]
</IfModule>

# --- Do not index directories ---------------------------------------------
Options -Indexes
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

# --- Strip PHP version fingerprint ---------------------------------------
<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always unset X-Pingback
  Header unset Server
</IfModule>
# END SKALUM HARDENING

# BEGIN LSCACHE
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
<IfModule mod_rewrite.c>
RewriteEngine on
RewriteRule litespeed/debug/.*\.log$ - [F,L]
RewriteRule \.litespeed_conf\.dat - [F,L]
</IfModule>
<IfModule LiteSpeed>
CacheLookup on
RewriteRule .* - [E=Cache-Control:no-autoflush]

### marker ASYNC start ###
RewriteCond %{REQUEST_URI} /wp-admin/admin-ajax\.php
RewriteCond %{QUERY_STRING} action=async_litespeed
RewriteRule .* - [E=noabort:1]
### marker ASYNC end ###

### marker DROPQS start ###
CacheKeyModify -qs:fbclid
CacheKeyModify -qs:gclid
CacheKeyModify -qs:utm*
CacheKeyModify -qs:_ga
### marker DROPQS end ###

</IfModule>
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
# END LSCACHE
# BEGIN NON_LSCACHE
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
# END NON_LSCACHE
# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress